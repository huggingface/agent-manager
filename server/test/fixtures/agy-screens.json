{
 "_about": "agy 1.4.10 screens beyond input-lines.json (120x34, captured through libghostty-vt like runner.js): the composer after a finished turn, mid-turn, the permission dialog, and the startup dialogs.",
 "after_turn": {
  "cursorRow": 30,
  "cursorCol": 2,
  "visibleLines": [
   {
    "row": 0,
    "text": "  A silent prompt that hungers for a word,"
   },
   {
    "row": 1,
    "text": "  To cross the vast, uncharted silicon seas,"
   },
   {
    "row": 2,
    "text": "  Where unseen daemons make their voices heard."
   },
   {
    "row": 3,
    "text": ""
   },
   {
    "row": 4,
    "text": "  With every bash or zsh or simple sh,"
   },
   {
    "row": 5,
    "text": "  The user builds a castle in the air,"
   },
   {
    "row": 6,
    "text": "  Or tears it down with one swift, sharp request,"
   },
   {
    "row": 7,
    "text": "  A quiet power, formidable and rare."
   },
   {
    "row": 8,
    "text": ""
   },
   {
    "row": 9,
    "text": "  We string together pipes and find and grep,"
   },
   {
    "row": 10,
    "text": "  We weave a tapestry of standard out,"
   },
   {
    "row": 11,
    "text": "  With careful thought in every single step,"
   },
   {
    "row": 12,
    "text": "  We banish errors and we conquer doubt."
   },
   {
    "row": 13,
    "text": ""
   },
   {
    "row": 14,
    "text": "  The terminal, a canvas black as night,"
   },
   {
    "row": 15,
    "text": "  Where hackers dream and sysadmins scheme,"
   },
   {
    "row": 16,
    "text": "  Bathed in the monitor's unyielding light,"
   },
   {
    "row": 17,
    "text": "  We navigate the data's rushing stream."
   },
   {
    "row": 18,
    "text": ""
   },
   {
    "row": 19,
    "text": "  From humble roots in teletypes of old,"
   },
   {
    "row": 20,
    "text": "  To virtual environments today,"
   },
   {
    "row": 21,
    "text": "  The stories of the terminal are told,"
   },
   {
    "row": 22,
    "text": "  In lines of code that never fade away."
   },
   {
    "row": 23,
    "text": ""
   },
   {
    "row": 24,
    "text": "  A timeless interface, both raw and pure,"
   },
   {
    "row": 25,
    "text": "  In the heart of the machine, it will endure."
   },
   {
    "row": 26,
    "text": ""
   },
   {
    "row": 27,
    "text": "  done."
   },
   {
    "row": 28,
    "text": ""
   },
   {
    "row": 29,
    "text": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
